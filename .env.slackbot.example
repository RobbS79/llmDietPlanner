# Slack <-> Claude Code bridge secrets.
# Copy to .env.slackbot and fill in. .env.slackbot is gitignored.

# From your Slack app -> "Basic Information" -> "App-Level Tokens" (Socket Mode)
SLACK_APP_TOKEN=xapp-...

# From your Slack app -> "OAuth & Permissions" -> "Bot User OAuth Token"
SLACK_BOT_TOKEN=xoxb-...

# From https://console.anthropic.com/ -> API Keys
ANTHROPIC_API_KEY=sk-ant-...

# Comma-separated. Right-click channel -> View details to copy channel IDs.
# Private channels begin with G, public with C, DMs with D.
SLACK_ALLOWED_CHANNELS=C0123456789

# Comma-separated. Slack profile -> "..." -> Copy member ID. Begin with U.
SLACK_ALLOWED_USERS=U0123456789

# Optional. Seconds before an idle thread session is torn down.
SLACKBOT_IDLE_TIMEOUT=1800

# Optional. INFO or DEBUG.
SLACKBOT_LOG_LEVEL=INFO
