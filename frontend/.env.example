# =============================================================================
# LLM Diet Planner Frontend - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# IMPORTANT: React environment variables must start with REACT_APP_
# IMPORTANT: These values are embedded at BUILD TIME, not runtime!
#            After changing these values, you must rebuild/restart the app.
# =============================================================================

# -----------------------------------------------------------------------------
# Google OAuth 2.0 (Required for "Sign in with Google")
# -----------------------------------------------------------------------------
# Get this from: https://console.cloud.google.com/apis/credentials
#
# CRITICAL SETUP STEPS:
# 1. Create OAuth 2.0 Client ID (Web application type)
# 2. Add "Authorized JavaScript origins":
#    - http://localhost:3000 (for local development)
#    - https://your-production-domain.com (for production)
# 3. OAuth consent screen must be:
#    - Set to "Production" (published), OR
#    - Set to "Testing" with your Google account added as a test user
#
# TROUBLESHOOTING:
# - If popup closes immediately: Check JavaScript origins in Google Cloud Console
# - If "popup_closed" error appears: Your origin is not authorized
# - Check browser console for detailed error messages
# -----------------------------------------------------------------------------
REACT_APP_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
# Backend API URL (defaults to /api for same-origin requests)
# REACT_APP_API_URL=/api

# For development with separate frontend/backend:
# REACT_APP_API_URL=http://localhost:8000/api
