# PHASE 3: Production Build Pipeline

# --- STAGE 1: Frontend Build ---
    FROM node:20-alpine AS builder
    WORKDIR /app/frontend
    
    # Install dependencies separately to leverage cache
    COPY frontend/package*.json ./
    RUN npm install --legacy-peer-deps
    
    # Copy source and build
    COPY frontend/ ./
    # This creates the /app/frontend/dist folder
    RUN npm run build 
    
    # --- STAGE 2: Python/Django ---
    FROM python:3.11-slim
    ENV PYTHONDONTWRITEBYTECODE=1
    ENV PYTHONUNBUFFERED=1
    WORKDIR /app
    
    # Install system dependencies
    RUN apt-get update && apt-get install -y \
        postgresql-client \
        redis-server \
        && rm -rf /var/lib/apt/lists/*
    
    # Install Python requirements
    COPY requirements.txt ./
    RUN pip install --no-cache-dir -r requirements.txt
    
    # Copy backend source
    COPY . .
    
    # Move build results from builder stage to the location settings.py expects
    COPY --from=builder /app/frontend/dist /app/frontend/dist
    
    RUN chmod +x start.sh
    EXPOSE 8000
    
    # Start.sh handles migrations and collectstatic at runtime
    CMD ["bash", "/app/start.sh"]