# PHASE 3: Production Build Pipeline

# --- STAGE 1: Frontend Build (Vite) ---
    FROM node:20-alpine AS builder
    WORKDIR /app/frontend
    
    # Define Build Arguments
    # DigitalOcean passes "Build and Run Time" env vars as build arguments
    ARG VITE_GOOGLE_CLIENT_ID
    
    # Copy package files first to optimize layer caching
    COPY frontend/package*.json ./
    RUN npm install --legacy-peer-deps
    
    # Copy frontend source
    COPY frontend/ ./
    
    # The VITE_ prefix tells Vite to include this variable in the client bundle.
    # We ensure it's available in the environment for the build command.
    RUN VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID npm run build:prod
    
    # --- STAGE 2: Python / Django ---
    FROM python:3.11-slim
    ENV PYTHONDONTWRITEBYTECODE=1
    ENV PYTHONUNBUFFERED=1
    WORKDIR /app
    
    # Install system dependencies
    RUN apt-get update && apt-get install -y \
        postgresql-client \
        redis-server \
        && rm -rf /var/lib/apt/lists/*
    
    # Install Python requirements
    COPY requirements.txt ./
    RUN pip install --no-cache-dir -r requirements.txt
    
    # Copy all backend source code
    COPY . .
    
    # Copy the Vite build results from Stage 1 into the folder Django expects
    COPY --from=builder /app/frontend/dist /app/frontend/dist
    
    RUN chmod +x start.sh
    EXPOSE 8000
    
    # Start.sh runs 'collectstatic' at runtime, picking up the copied /frontend/dist files
    CMD ["bash", "/app/start.sh"]